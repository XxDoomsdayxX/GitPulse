{
  "name": "gitpulse",
  "productName": "GitPulse",
  "version": "1.1.0",
  "description": "Floating desktop widget for monitoring GitHub repository sync status.",
  "main": "main.js",
  "author": "XxDoomsdayxX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/XxDoomsdayxX/GitPulse.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:app": "electron test/smoke.electron.js",
    "generate-icon": "node scripts/generate-icon.js",
    "build": "npm run generate-icon && electron-builder --win",
    "dist": "npm run build"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.gitpulse.widget",
    "productName": "GitPulse",
    "copyright": "Copyright © 2026 GitPulse",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "XxDoomsdayxX",
        "repo": "GitPulse",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GitPulse",
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
